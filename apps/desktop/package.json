{
  "name": "@tw/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio del operador (Electron + React). Windows y Mac.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:main": "tsc -b",
    "build:renderer": "vite build",
    "dev": "vite",
    "dev:electron": "tsc -b && electron .",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.renderer.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never"
  },
  "dependencies": {
    "@tw/shared": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.telecomway.traductor",
    "productName": "Telecomway Traductor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**",
      "dist/preload/**",
      "dist/renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Telecomway usa el micrófono para traducir tus llamadas."
      }
    },
    "electronVersion": "45.0.0"
  },
  "author": "Telecomway"
}
