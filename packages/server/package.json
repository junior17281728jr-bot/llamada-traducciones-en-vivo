{
  "name": "@tw/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor puente: canales de llamada, sesiones de llamada, operadores por WebSocket, historial y grabaciones.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@tw/pipeline": "*",
    "@tw/shared": "*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
