# Telecomway: variables de entorno del servidor.
# Copia este archivo a ".env" (NO lo subas a git) y rellena lo que necesites.
# Las claves también se pueden introducir desde Ajustes (como administrador): la clave guardada
# en Ajustes tiene prioridad sobre la de esta lista. Nunca pongas secretos en el código.
#
# Todo lo marcado UNVERIFIED está basado en resúmenes de la documentación y no se ha probado
# contra el servicio real.

# ---------------------------------------------------------------------------
# Modo de funcionamiento
# ---------------------------------------------------------------------------
# mock: voz a texto, traductor y voz simulados (no contacta ningún servicio real).
# elevenlabs: ElevenLabs para voz (STT y TTS) y Claude para traducir.
PROVIDERS=mock
# Canal de llamadas. mock: pasajeros simulados por WebSocket (/sim).
# twilio y whatsapp están previstos pero NO implementados.
CHANNEL=mock

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Carpeta de datos: historial, preferencias, claves cifradas y grabaciones.
DATA_DIR=./data
# Clave para cifrar en reposo las claves guardadas desde Ajustes (AES-256-GCM).
# Si se deja vacía, el servidor genera un archivo de clave en DATA_DIR con permisos 0600.
SECRETS_KEY=
# Secreto para firmar los tokens de sesión de los operadores. Si se deja vacío, se genera uno en DATA_DIR.
SESSION_SECRET=
# Administrador inicial (se crea al arrancar si aún no hay usuarios). Cambia la contraseña.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Operadores iniciales, separados por comas, con el formato usuario:contraseña
# (solo para empezar; luego se gestionan desde Ajustes).
OPERATORS=

# ---------------------------------------------------------------------------
# Llamadas
# ---------------------------------------------------------------------------
# Llamadas simultáneas máximas (el cliente trabaja con 3 operadores y 3 llamadas).
MAX_CONCURRENT_CALLS=3
# true: las llamadas entrantes se contestan solas. Cada operador puede cambiarlo en sus preferencias.
AUTO_ACCEPT=false
# Segundos que suena una llamada entrante en un operador antes de pasar a otro.
RING_TIMEOUT_SECONDS=30
# Grabar las llamadas (ambas voces) en DATA_DIR. Revisa la normativa de protección de datos antes de activarlo.
RECORD_CALLS=false
# Días que se conservan historial y grabaciones (0 = sin límite).
RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Idiomas
# ---------------------------------------------------------------------------
# Idioma del operador por defecto (lo que habla y oye).
DEFAULT_OPERATOR_LANG=es
# Modo de idiomas por defecto de cada llamada nueva: auto, manual o mixed.
DEFAULT_LANGUAGE_MODE=auto
# Idioma de respaldo cuando no se conoce el del pasajero y se acaba la espera.
FALLBACK_LANG=en
# Segundos que se retiene el texto del operador mientras no se conoce el idioma del pasajero.
LANG_HOLD_SECONDS=4
# Detección automática del idioma del pasajero:
# segmentos seguidos en que coinciden el STT y Claude para confirmar el idioma...
LANG_CONFIRM_SEGMENTS=2
# ...palabras mínimas de un segmento para que cuente...
LANG_MIN_WORDS=3
# ...probabilidad mínima de idioma del STT (de 0 a 1; el campo es UNVERIFIED)...
LANG_MIN_PROBABILITY=0.6
# ...y segmentos seguidos en otro idioma para cambiar un idioma ya confirmado.
LANG_CHANGE_SEGMENTS=3
# true: al arrancar, pregunta a ElevenLabs qué idiomas admite (GET /v1/models, UNVERIFIED). Requiere clave.
LANGUAGE_CATALOG_LIVE=false

# ---------------------------------------------------------------------------
# ElevenLabs (STT y TTS). UNVERIFIED: nombres y formatos tomados de resúmenes de la documentación.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Dirección base de la API (cámbiala solo para pruebas contra un servidor local).
ELEVENLABS_BASE_URL=wss://api.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2_realtime
# pcm_16000 recomendado. Otros: pcm_8000, pcm_22050, pcm_24000, pcm_44100, pcm_48000, ulaw_8000.
ELEVENLABS_STT_AUDIO_FORMAT=pcm_16000
# manual, vad o turn_prediction.
ELEVENLABS_STT_COMMIT_STRATEGY=vad
# Silencio que cierra una frase con VAD, en segundos (de 0.3 a 3.0).
ELEVENLABS_STT_VAD_SILENCE_SECONDS=0.8
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Formato de salida de la voz. Documentados: mp3_44100_128, ulaw_8000, alaw_8000, pcm_44100 (plan Pro).
# pcm_16000 NO está confirmado. Se decodifican: pcm_16000, pcm_22050, pcm_24000, pcm_44100, ulaw_8000.
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_16000
# Cadencia de generación de la voz (caracteres por bloque).
ELEVENLABS_TTS_CHUNK_SCHEDULE=120,160,250,290
# Una voz por idioma (voice_id de tu cuenta; no hay valores por defecto). Añade las que necesites
# con el patrón ELEVENLABS_VOICE_<CÓDIGO DE IDIOMA EN MAYÚSCULAS>.
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_IT=
ELEVENLABS_VOICE_PT=
ELEVENLABS_VOICE_DE=
ELEVENLABS_VOICE_NL=
ELEVENLABS_VOICE_PL=
ELEVENLABS_VOICE_RU=
ELEVENLABS_VOICE_AR=
ELEVENLABS_VOICE_ZH=
ELEVENLABS_VOICE_TR=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_HI=

# ---------------------------------------------------------------------------
# Traductor (Claude, API de Anthropic). También identifica el idioma de cada frase.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
TRANSLATOR_MODEL=claude-haiku-5-5

# ---------------------------------------------------------------------------
# Canales futuros (previstos, NO implementados; nombres UNVERIFIED)
# ---------------------------------------------------------------------------
# Número de la empresa al que llaman todos los pasajeros.
COMPANY_NUMBER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Meta / WhatsApp Business Calling
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
